# No secrets are needed today. Keep it that way unless something genuinely
# requires a server-side key.

# Canonical site URL. Used for metadata, canonical tags, sitemap, robots and
# JSON-LD. Set this to the real domain in the host's environment variables -
# leaving the placeholder in place tells Google the real pages live elsewhere.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Search engine indexing. Left unset (or anything but "true") the whole site is
# noindex + disallow, which is what you want while the content is placeholder.
# Set to true on launch day, once the real business details, photos, reviews and
# FAQ answers are in.
NEXT_PUBLIC_SITE_INDEXABLE=false
